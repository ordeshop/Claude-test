name: Seite hochladen

# Laedt den Inhalt von site/ per FTP auf den Server.
#
# Laeuft nur, wenn sich am Inhalt der Seite wirklich etwas geaendert hat -
# eine Notiz in unterlagen/ loest nichts aus.
#
# Vorher einrichten unter Settings -> Secrets and variables -> Actions:
#   FTP_SERVER     Serveradresse des Hosters
#                  Bei Hostinger steht der Zielordner meist auf public_html,
#                  bei anderen Hostern auf httpdocs oder htdocs -
#                  server-dir weiter unten entsprechend anpassen.
#   FTP_USERNAME   FTP-Benutzername
#   FTP_PASSWORD   FTP-Passwort
#
# Solange die Secrets fehlen, ueberspringt der Lauf das Hochladen mit einem
# Hinweis - er schlaegt nicht fehl. So kommen keine Fehlermails, bevor das
# Hosting ueberhaupt gebucht ist.

on:
  push:
    branches: [main]
    paths:
      - 'build.py'
      - 'quelle/**'
      - 'site/**'
      - '.github/workflows/seite-hochladen.yml'
  workflow_dispatch:   # erlaubt zusaetzlich den Start per Knopfdruck

concurrency:
  group: seite-hochladen
  cancel-in-progress: false

jobs:
  hochladen:
    runs-on: ubuntu-latest
    steps:
      - name: Dateien holen
        uses: actions/checkout@v4

      - name: Pruefen, ob die Zugangsdaten hinterlegt sind
        id: pruefung
        run: |
          if [ -z "${{ secrets.FTP_SERVER }}" ]; then
            echo "bereit=nein" >> "$GITHUB_OUTPUT"
            echo "::notice::Hochladen uebersprungen - FTP_SERVER ist noch nicht gesetzt. Sobald das Hosting gebucht ist, FTP_SERVER, FTP_USERNAME und FTP_PASSWORD unter Settings -> Secrets and variables -> Actions hinterlegen. Danach laeuft das hier von selbst."
          else
            echo "bereit=ja" >> "$GITHUB_OUTPUT"
          fi

      - name: Seite neu bauen
        run: python3 build.py

      - name: Per FTP auf den Server laden
        if: steps.pruefung.outputs.bereit == 'ja'
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        with:
          server: ${{ secrets.FTP_SERVER }}
          username: ${{ secrets.FTP_USERNAME }}
          password: ${{ secrets.FTP_PASSWORD }}
          protocol: ftps
          local-dir: ./site/
          server-dir: ./public_html/
          dangerous-clean-slate: false
          exclude: |
            **/.git*
            **/.git*/**
            **/*.md
